# ============================================
# H&M Servicios — Variables de Entorno
# ============================================
# Copie este archivo como .env y configure los valores

# Puerto del servidor
PORT=3000

# Secretos JWT (use cadenas largas y aleatorias en producción)
JWT_SECRET=your_jwt_secret_change_me_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_me_in_production

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Comisión de la empresa (porcentaje, por defecto 15%)
COMPANY_COMMISSION_RATE=15

# Base de datos: Turso (libSQL), recomendado para producción.
# Déjalas vacías/comentadas para desarrollo local (usa un archivo SQLite
# local en DB_PATH en su lugar). En Vercel son obligatorias — sin ellas la
# base de datos vive en /tmp y se pierde entre invocaciones.
# TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
# TURSO_AUTH_TOKEN=tu_token_de_turso

# Ruta de la base de datos SQLite local (solo se usa si no hay TURSO_DATABASE_URL)
DB_PATH=./data/hm_servicios.db

# Entorno (development | production)
NODE_ENV=development
